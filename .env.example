# ================================================================
# Serbabisa POS — Environment
# SALIN ke .env dan isi nilai sesuai kebutuhan. JANGAN commit .env!
# ================================================================

# --- Database (PostgreSQL / Supabase) ---
# Sandbox/dev (session pooler, IPv4-friendly, mendukung DDL + prepared statements):
# postgresql://postgres.<project-ref>:<password-encoded>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# Vercel/serverless (transaction pooler — WAJIB pgbouncer=true & connection_limit=1):
# postgresql://postgres.<project-ref>:<password-encoded>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# CATATAN: karakter khusus di password (mis. @) WAJIB di-percent-encode → %40
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@YOUR-POOLER-HOST:5432/postgres"

# --- Seed (opsional; hanya dipakai `bun run seed` / `bun run bootstrap-admin`) ---
# SUPER_ADMIN_EMAIL="admin@yourdomain.com"
# SUPER_ADMIN_PASSWORD="ganti-password-kuat-ini"
# DEMO_KASIR_PASSWORD="ganti-juga-ini"
