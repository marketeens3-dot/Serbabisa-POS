// Serbabisa — Multi-tenant POS SaaS
// PostgreSQL (Supabase): enum & Json tetap String + validasi Zod di lib/constants.ts & lib/validation.ts
// Money = Int (rupiah, IDR tanpa subunit) → bebas floating point.

generator client {
  provider = "prisma-client-js"
  // "native" = engine untuk mesin build ini (Windows saat ini).
  // "windows" eksplisit agar client bisa dipakai juga di runtime lain
  // (mis. build di Linux, jalan di Windows) — engine Prisma berbasis N-API
  // sehingga tetap kompatibel dengan Node maupun Electron (ABI berbeda).
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  fullName           String
  phone              String?
  role               String    @default("USER") // SUPER_ADMIN | USER (lib/constants.ts)
  status             String    @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED
  tenantId           String?
  tenant             Tenant?   @relation(fields: [tenantId], references: [id])
  mustChangePassword Boolean   @default(false)
  failedLoginAttempts Int      @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refundedTransactions Transaction[] @relation("RefundedBy")
  sessions           Session[]
  transactions       Transaction[]      @relation("Cashier")
  voidedTransactions Transaction[]      @relation("VoidedBy")
  cashSessions       CashSession[]      @relation("CashSessionOpener")
  auditLogs          AuditLog[]

  @@index([tenantId])
  @@index([role, status])
  @@index([status])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model Tenant {
  id              String   @id @default(uuid())
  businessName    String
  slug            String   @unique
  phone           String?
  whatsappNumber  String?
  address         String?
  logoUrl         String?
  currency        String   @default("IDR")
  timezone        String   @default("Asia/Jakarta")
  isActive        Boolean  @default(true)
  invoiceSettings String   @default("{}") // JSON string: { whatsappTemplate, defaultPaymentMethod }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users            User[]
  categories       Category[]
  catalogItems     CatalogItem[]
  customers        Customer[]
  transactions     Transaction[]
  cashSessions     CashSession[]
  invoiceTemplates InvoiceTemplate[]
  invoiceCounters  InvoiceCounter[]
  auditLogs        AuditLog[]
  devices          Device[]
  projects         Project[]
  cashflowEntries  CashflowEntry[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  debts            Debt[]
  stockOpnames     StockOpname[]
  vouchers         Voucher[]
  pointsLedgers    PointsLedger[]

  @@index([isActive])
}

model Category {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items CatalogItem[]

  @@unique([tenantId, normalizedName])
  @@index([tenantId, isActive])
}

model CatalogItem {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         String // PRODUCT | SERVICE
  name         String
  sku          String?
  barcode      String?
  description  String?
  // URL gambar produk (hasil konversi WebP di Supabase Storage, public bucket).
  // Boleh null — UI kasir memakai placeholder emoji + blob pastel.
  imageUrl     String?
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  costPrice    Int      @default(0)
  sellingPrice Int
  // Diskon per unit (Rp) — harga jual efektif = sellingPrice − discountAmount.
  // Otomatis jadi diskon baris di kasir (bisa dioverride per transaksi).
  discountAmount Int    @default(0)
  stockQty     Float    @default(0)
  minStockQty  Float    @default(0)
  unit         String   @default("pcs")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactionItems TransactionItem[]
  inventoryMovements InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  stockOpnameItems   StockOpnameItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, type, isActive])
  @@index([tenantId, name])
  @@index([categoryId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String? // dinormalisasi 62xxx
  email     String?
  address   String?
  notes     String?
  // Loyalty poin (Tier 2): bertambah otomatis per transaksi dengan pelanggan,
  // dikurangi saat redeem/penyesuaian manual. Riwayat lengkap di PointsLedger.
  points    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions   Transaction[]
  pointsLedgers  PointsLedger[]
  debts          Debt[]
  projects       Project[]

  @@index([tenantId, name])
  @@index([tenantId, phone])
  @@index([tenantId, isActive])
}

model Transaction {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  cashierId      String
  cashier        User     @relation("Cashier", fields: [cashierId], references: [id])
  cashSessionId  String?
  cashSession    CashSession? @relation("CashSessionTx", fields: [cashSessionId], references: [id])
  invoiceNumber  String
  subtotal       Int
  discountAmount Int      @default(0)
  // Persen diskon transaksi (0-100, maks 2 desimal) — diterapkan ke SELURUH item.
  // Server selalu menghitung ulang discountAmount dari persen ini (anti price tampering);
  // disimpan agar nota bisa menampilkan "Diskon 10%". 0 = diskon nominal/manual.
  discountPercent Float  @default(0)
  taxAmount      Int      @default(0)
  totalAmount    Int
  paidAmount     Int
  changeAmount   Int
  paymentMethod  String // CASH | TRANSFER | QRIS | OTHER
  status         String   @default("COMPLETED") // COMPLETED | VOID | REFUNDED
  notes          String?
  voidReason     String?
  voidedAt       DateTime?
  voidedById     String?
  voidedBy       User?    @relation("VoidedBy", fields: [voidedById], references: [id])
  // Refund (parsial kumulatif; status REFUNDED saat seluruh item terrefund)
  refundedAmount Int      @default(0)
  refundReason   String?
  refundedAt     DateTime?
  refundedById   String?
  refundedBy     User?    @relation("RefundedBy", fields: [refundedById], references: [id])
  // Penjualan untuk proyek/RAB — checkout dengan projectId membuat RabRealization
  // otomatis per item (source SALE). SetNull: hapus proyek tidak menghapus penjualan.
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Voucher/promo (Tier 2): kode + nominal diskon voucher terekam untuk pelaporan.
  voucherCode    String?
  voucherDiscount Int     @default(0)
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items TransactionItem[]
  inventoryMovements InventoryMovement[]
  realizations RabRealization[]
  debts Debt[]
  pointsLedgers PointsLedger[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  // Composite utk query tersering: filter tenant + status COMPLETED + rentang tanggal
  // (dashboard, laporan, ringkasan) — menggantikan pemilihan salah satu index tunggal.
  @@index([tenantId, status, createdAt])
  // Wajib: hitung total shift (computeSessionTotals) di-poll tiap 30 detik per kasir
  // dan dipakai API detail shift/export — tanpa ini jadi sequential scan lintas tenant.
  @@index([cashSessionId, status])
  @@index([customerId])
  @@index([cashierId])
  @@index([createdAt])
}

model TransactionItem {
  id               String        @id @default(uuid())
  transactionId    String
  transaction      Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  catalogItemId    String?
  catalogItem      CatalogItem?  @relation(fields: [catalogItemId], references: [id])
  itemType         String // PRODUCT | SERVICE
  itemNameSnapshot String
  skuSnapshot      String?
  quantity         Float
  unitPrice        Int
  // subtotal = NET baris: round(qty × unitPrice) − discountAmount.
  // Transaction.subtotal = Σ subtotal item → rumus total lama tetap berlaku.
  subtotal         Int
  discountAmount   Int           @default(0) // diskon Rp untuk baris ini (maks = harga baris)
  discountPercent  Float         @default(0) // persen diskon baris — utk tampilan nota (server hitung ulang)
  refundedQty      Float        @default(0) // kumulatif qty yang direfund per item
  createdAt        DateTime      @default(now())

  @@index([transactionId])
  @@index([catalogItemId])
}

model InvoiceCounter {
  id         String @id @default(uuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year       Int
  lastNumber Int    @default(0)

  @@unique([tenantId, year])
}

// Jejak mutasi stok (blueprint FR-08): SALE mengurangi, VOID mengembalikan.
model InventoryMovement {
  id            String        @id @default(uuid())
  tenantId      String
  catalogItemId String
  catalogItem   CatalogItem   @relation(fields: [catalogItemId], references: [id])
  transactionId String?
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  movementType  String // SALE | VOID_RETURN | REFUND_RETURN | ADJUSTMENT
  quantity      Float // nilai positif; arah ditentukan movementType
  note          String?
  createdAt     DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([catalogItemId])
  @@index([transactionId])
}

// Sesi kasir (shift) — rekonsiliasi kas: kas awal + penjualan tunai vs hasil hitung fisik.
model CashSession {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("CashSessionOpener", fields: [userId], references: [id])
  openingCash Int       @default(0)
  closingCash Int? // hasil hitung fisik kasir saat tutup
  expectedCash Int? // openingCash + total penjualan tunai (snapshot saat tutup)
  difference  Int? // closingCash - expectedCash (selisih; negatif = kurang)
  status      String    @default("OPEN") // OPEN | CLOSED
  notes       String?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  transactions Transaction[] @relation("CashSessionTx")

  @@index([tenantId, status])
  @@index([tenantId, userId, openedAt])
  @@index([status])
}

model InvoiceTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  config    String // JSON InvoiceTemplateConfig (divalidasi Zod)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action       String
  resourceType String?
  resourceId   String?
  metadata     String? // JSON string — TIDAK BOLEH berisi kredensial/secret
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     String // JSON string
  updatedAt DateTime @updatedAt
}

// ============================================================================
// OFFLINE / SYNC
//
// Aplikasi desktop berjalan LOCAL-FIRST: seluruh baca/tulis terjadi pada SQLite
// lokal (prisma/schema.sqlite.prisma — hasil generate dari file ini). Supabase
// adalah salinan bersama antar perangkat + tempat identitas (user, tenant).
//
// Tiga model di bawah inilah yang memungkinkan sinkronisasi multi-perangkat.
// ============================================================================

// Registry perangkat kasir. Dibuat di cloud saat perangkat pertama kali sync;
// dipakai untuk reservasi blok nomor nota.
model Device {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  platform   String   @default("WINDOWS")
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  invoiceBlocks    InvoiceBlock[]
  @@unique([tenantId, name])
  @@index([tenantId])
}

// Reservasi blok nomor nota per perangkat.
//
// MASALAH: dua perangkat offline bisa sama-sama menerbitkan INV-2026-000005.
// SOLUSI: perangkat memesan blok nomor (mis. 1..50) dari cloud saat online,
// lalu memakai sendiri saat offline. Cloud menaikkan InvoiceCounter secara
// atomik per pemesanan → nomor tetap UNIK dan FORMAT tidak berubah
// (INV-YYYY-NNNNNN), jadi nota yang sudah tercetak tetap sah.
model InvoiceBlock {
  id        String   @id @default(uuid())
  tenantId  String
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  year      Int
  startSeq  Int
  endSeq    Int // inklusif
  createdAt DateTime @default(now())

  @@unique([tenantId, deviceId, startSeq])
  @@index([tenantId, year])
  @@index([deviceId])
}

// Buku besar status sinkron per perangkat.
//
// Dipakai di sisi perangkat: menandai entitas yang berubah lokal sejak push
// terakhir (dirty) dan yang sudah soft-deleted (deletedAt) supaya penghapusan
// ikut merambat ke cloud. Di sisi cloud tabel ini tidak pernah ditulis.
model SyncState {
  entity     String
  entityId   String
  dirty      Boolean  @default(false)
  deletedAt  DateTime?
  syncedAt   DateTime?
  syncedHash String? // hash isi saat push/pull terakhir (deteksi tabrakan LWW)

  @@id([entity, entityId])
  @@index([entity, dirty])
}

// ============================================================================
// FINANS & OPERASIONAL (Tier 1 + Tier 2) — RAB, Cashflow, Hutang Piutang,
// Pembelian/Supplier, Stok Opname, Voucher, Loyalty Poin.
// Konvensi sama: money = Int rupiah, enum = String + validasi Zod.
// ============================================================================

// ---------- RAB (Rencana Anggaran Biaya) ----------
model Project {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String    // unik per tenant, mis. RAB-2026-001
  name        String
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  description String?
  status      String    @default("PLANNED") // PLANNED | ACTIVE | COMPLETED | CANCELLED
  budgetTotal Int       @default(0) // Σ budgetAmount item — dihitung ulang server
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items        RabItem[]
  realizations RabRealization[]
  transactions Transaction[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

// Item anggaran dalam proyek: nama barang/jasa, volume, satuan, harga anggaran.
model RabItem {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenantId     String
  name         String
  quantity     Float
  unit         String   @default("pcs")
  unitPrice    Int // anggaran per satuan
  budgetAmount Int // quantity × unitPrice — dihitung ulang server (anti tampering)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  realizations RabRealization[]

  @@index([projectId])
}

// Realisasi biaya proyek. Otomatis (source SALE): setiap item transaksi yang
// dibuat di kasir dengan projectId terisi. Manual (source MANUAL): dicatat dari
// halaman RAB (mis. pembayaran tenaga kerja yang tidak lewat katalog).
model RabRealization {
  id            String       @id @default(uuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenantId      String
  rabItemId     String?
  rabItem       RabItem?     @relation(fields: [rabItemId], references: [id], onDelete: SetNull)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  description   String
  quantity      Float        @default(1)
  amount        Int
  source        String       @default("MANUAL") // MANUAL | SALE
  createdAt     DateTime     @default(now())

  @@index([projectId])
  @@index([tenantId, createdAt])
}

// ---------- CASHFLOW (kas masuk / keluar) ----------
// MANUAL        → diinput pemilik (gaji, sewa, setoran modal, dst.)
// DEBT_PAYMENT  → otomatis saat cicilan piutang/hutang dibayar CASH
// PURCHASE_CASH → otomatis saat PO diterima dan dibayar tunai
model CashflowEntry {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  direction   String   // IN | OUT
  category    String
  amount      Int
  note        String?
  entryDate   DateTime
  source      String   @default("MANUAL") // MANUAL | DEBT_PAYMENT | PURCHASE_CASH
  refType     String?  // DebtPayment | PurchaseOrder
  refId       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, entryDate])
  @@index([tenantId, direction, entryDate])
}

// ---------- SUPPLIER & PEMBELIAN ----------
model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  debts          Debt[]

  @@index([tenantId, name])
}

model PurchaseOrder {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String    // PO-YYYYMMDD-NNN — generate server, unik per tenant
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  status      String    @default("DRAFT") // DRAFT | ORDERED | RECEIVED | CANCELLED
  totalAmount Int       @default(0)
  note        String?
  orderedAt   DateTime?
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items PurchaseOrderItem[]
  debts Debt[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseId       String
  purchase         PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  tenantId         String
  catalogItemId    String
  catalogItem      CatalogItem   @relation(fields: [catalogItemId], references: [id])
  itemNameSnapshot String
  quantity         Float
  unitCost         Int // harga beli per unit — jadi costPrice (HPP terakhir) saat diterima
  subtotal         Int
  createdAt        DateTime      @default(now())

  @@index([purchaseId])
}

// ---------- HUTANG PIUTANG ----------
// RECEIVABLE = piutang pelanggan (jual tempo, otomatis dari checkout TEMPO)
// PAYABLE    = hutang supplier (beli tempo, otomatis saat PO diterima TEMPO)
model Debt {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          String         // RECEIVABLE | PAYABLE
  amount        Int
  paidAmount    Int            @default(0)
  status        String         @default("UNPAID") // UNPAID | PARTIAL | PAID
  dueDate       DateTime?
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  supplierId    String?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  transactionId String?
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  purchaseId    String?
  purchase      PurchaseOrder? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  note          String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  payments DebtPayment[]

  @@index([tenantId, type, status])
  @@index([tenantId, dueDate])
}

model DebtPayment {
  id           String   @id @default(uuid())
  debtId       String
  debt         Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  tenantId     String
  amount       Int
  method       String   @default("CASH") // CASH | TRANSFER | QRIS | OTHER
  note         String?
  paidAt       DateTime @default(now())
  receivedById String?
  createdAt    DateTime @default(now())

  @@index([debtId])
}

// ---------- STOK OPNAME ----------
model StockOpname {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items StockOpnameItem[]

  @@index([tenantId, createdAt])
}

model StockOpnameItem {
  id               String      @id @default(uuid())
  opnameId         String
  opname           StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  tenantId         String
  catalogItemId    String
  catalogItem      CatalogItem @relation(fields: [catalogItemId], references: [id])
  itemNameSnapshot String
  systemQty        Float
  physicalQty      Float
  diffQty          Float // physical − system (negatif = kurang)
  createdAt        DateTime    @default(now())

  @@index([opnameId])
}

// ---------- VOUCHER / PROMO ----------
model Voucher {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String // unik per tenant, disimpan UPPERCASE
  type        String    // PERCENT | FIXED
  value       Int // PERCENT: 1-100; FIXED: nominal Rp
  minPurchase Int       @default(0)
  maxDiscount Int? // khusus PERCENT — batas diskon maksimal
  usageLimit  Int? // null = tanpa batas pemakaian
  usageCount  Int       @default(0)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

// ---------- LOYALTY POIN ----------
// Poin otomatis per transaksi COMPLETED berpelanggan: floor(total / LOYALTY_EARN_DIVISOR).
// Perubahan manual (redeem di kasir / koreksi) dicatat type REDEEM / ADJUST.
model PointsLedger {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points        Int // bertanda: + earn/adjust naik, − redeem/adjust turun
  type          String       // EARN | REDEEM | ADJUST
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime     @default(now())

  @@index([customerId, createdAt])
  @@index([tenantId, createdAt])
}
